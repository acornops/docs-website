{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AcornOps",
  "colors": {
    "primary": "#FF703B",
    "light": "#FF8B5C",
    "dark": "#E65F2F"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Outfit",
    "heading": {
      "family": "Outfit",
      "weight": 700
    },
    "body": {
      "family": "Outfit",
      "weight": 400
    }
  },
  "background": {
    "color": {
      "light": "#FBFBFA",
      "dark": "#121110"
    }
  },
  "favicon": "/favicon.svg",
  "redirects": [
    {
      "source": "/api-reference",
      "destination": "/developer/api-overview"
    },
    {
      "source": "/architecture",
      "destination": "/overview/architecture"
    },
    {
      "source": "/security",
      "destination": "/overview/security"
    },
    {
      "source": "/quickstart",
      "destination": "/deploy"
    },
    {
      "source": "/deployment",
      "destination": "/deploy/deployment-reference"
    },
    {
      "source": "/configuration",
      "destination": "/deploy/configuration-reference"
    },
    {
      "source": "/catalog-registries",
      "destination": "/use/mcp-registries"
    },
    {
      "source": "/automation",
      "destination": "/use/agents-and-workflows"
    },
    {
      "source": "/kubernetes-clusters",
      "destination": "/use/connect-kubernetes"
    },
    {
      "source": "/vm-targets",
      "destination": "/use/connect-vm"
    },
    {
      "source": "/integrations",
      "destination": "/developer/integrations"
    },
    {
      "source": "/api-overview",
      "destination": "/developer/api-overview"
    },
    {
      "source": "/mcp-tools",
      "destination": "/use/tools-and-mcp"
    },
    {
      "source": "/operations",
      "destination": "/deploy/operations"
    },
    {
      "source": "/admin-operations",
      "destination": "/deploy/admin-operations"
    },
    {
      "source": "/use/get-started",
      "destination": "/use/kubernetes-quick-start"
    },
    {
      "source": "/use/quick-start",
      "destination": "/use/kubernetes-quick-start"
    }
  ],
  "api": {
    "playground": {
      "display": "none"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript"
      ],
      "autogenerate": true
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "overview/how-acornops-works",
              "overview/core-concepts"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "overview/workspaces",
              "overview/targets",
              "overview/agents-and-workflows",
              "overview/sessions-runs-approvals",
              "overview/tools-mcp"
            ]
          },
          {
            "group": "Architecture",
            "pages": [
              "overview/architecture",
              "overview/security",
              "overview/glossary"
            ]
          }
        ]
      },
      {
        "tab": "User Guide",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "use/index",
              "use/kubernetes-quick-start",
              "use/vm-quick-start",
              "use/first-investigation"
            ]
          },
          {
            "group": "Investigate",
            "pages": [
              "use/target-chat",
              "use/issues-and-investigations",
              "use/automatic-investigations"
            ]
          },
          {
            "group": "Connect targets",
            "pages": [
              "use/connect-targets",
              "use/connect-kubernetes",
              "use/connect-vm"
            ]
          },
          {
            "group": "Manage a workspace",
            "pages": [
              "use/manage-workspace"
            ]
          },
          {
            "group": "Automation",
            "pages": [
              "use/agents-and-workflows"
            ]
          },
          {
            "group": "Tools and extensions",
            "pages": [
              "use/web-search",
              "use/target-insights",
              "use/tools-and-mcp",
              "use/mcp-registries"
            ]
          }
        ]
      },
      {
        "tab": "Admin Guide",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "deploy/index",
              "deploy/prerequisites"
            ]
          },
          {
            "group": "Install",
            "pages": [
              "deploy/kubernetes",
              "deploy/vm-compose",
              "deploy/deployment-reference"
            ]
          },
          {
            "group": "Configure",
            "pages": [
              "deploy/configuration",
              "deploy/configuration-reference",
              "deploy/automation-runtime"
            ]
          },
          {
            "group": "Govern",
            "pages": [
              "deploy/platform-admin-console",
              "deploy/admin-operations"
            ]
          },
          {
            "group": "Operate",
            "pages": [
              "deploy/production-readiness",
              "deploy/operations"
            ]
          }
        ]
      },
      {
        "tab": "Developer Guide",
        "groups": [
          {
            "group": "Build integrations",
            "pages": [
              "developer/index",
              "developer/integrations",
              "developer/api-overview"
            ]
          },
          {
            "group": "API reference",
            "openapi": {
              "source": "openapi/control-plane-public.json",
              "directory": "reference/control-plane"
            },
            "pages": [
              {
                "group": "Auth and users",
                "pages": [
                  "GET /api/v1/auth/oidc/login",
                  "GET /api/v1/auth/oidc/callback",
                  "GET /api/v1/auth/config",
                  "GET /api/v1/auth/csrf",
                  "POST /api/v1/auth/password/login",
                  "POST /api/v1/auth/password/signup",
                  "POST /api/v1/auth/password/verify-email",
                  "POST /api/v1/auth/password/resend-verification",
                  "POST /api/v1/auth/password/forgot",
                  "POST /api/v1/auth/password/reset",
                  "POST /api/v1/auth/password/change",
                  "POST /api/v1/auth/oidc/link/start",
                  "POST /api/v1/auth/external-integrations/link",
                  "POST /api/v1/auth/external-integrations/link/preview",
                  "POST /api/v1/auth/external-integrations/link/complete",
                  "GET /api/v1/auth/external-integrations/links",
                  "POST /api/v1/auth/external-integrations/links/unlink",
                  "POST /api/v1/auth/external-integrations/resolve",
                  "POST /api/v1/auth/external-integrations/revoke",
                  "POST /api/v1/auth/logout",
                  "GET /api/v1/me",
                  "GET /api/v1/auth/methods",
                  "GET /api/v1/auth/jwks.json"
                ]
              },
              {
                "group": "Workspaces and members",
                "pages": [
                  "GET /api/v1/workspaces",
                  "POST /api/v1/workspaces",
                  "GET /api/v1/workspaces/{workspaceId}",
                  "DELETE /api/v1/workspaces/{workspaceId}",
                  "GET /api/v1/workspaces/{workspaceId}/members",
                  "POST /api/v1/workspaces/{workspaceId}/members",
                  "PATCH /api/v1/workspaces/{workspaceId}/members/{userId}",
                  "DELETE /api/v1/workspaces/{workspaceId}/members/{userId}",
                  "GET /api/v1/workspaces/{workspaceId}/roles",
                  "GET /api/v1/workspaces/{workspaceId}/audit-log",
                  "GET /api/v1/workspaces/{workspaceId}/invitations",
                  "POST /api/v1/workspaces/{workspaceId}/invitations",
                  "DELETE /api/v1/workspaces/{workspaceId}/invitations/{invitationId}",
                  "GET /api/v1/workspace-invitations/{token}",
                  "POST /api/v1/workspace-invitations/{token}/accept"
                ]
              },
              {
                "group": "Targets and inventory",
                "pages": [
                  "GET /api/v1/workspaces/{workspaceId}/targets",
                  "GET /api/v1/workspaces/{workspaceId}/targets/{targetId}",
                  "GET /api/v1/workspaces/{workspaceId}/issues",
                  "GET /api/v1/workspaces/{workspaceId}/issues/{issueId}",
                  "GET /api/v1/workspaces/{workspaceId}/issues/{issueId}/observations",
                  "GET /api/v1/workspaces/{workspaceId}/targets/{targetId}/issues",
                  "GET /api/v1/workspaces/{workspaceId}/kubernetes-clusters",
                  "POST /api/v1/workspaces/{workspaceId}/kubernetes-clusters",
                  "GET /api/v1/workspaces/{workspaceId}/kubernetes-clusters/{clusterId}",
                  "PATCH /api/v1/workspaces/{workspaceId}/kubernetes-clusters/{clusterId}",
                  "DELETE /api/v1/workspaces/{workspaceId}/kubernetes-clusters/{clusterId}",
                  "POST /api/v1/workspaces/{workspaceId}/kubernetes-clusters/{clusterId}/rotate-agent-key",
                  "GET /api/v1/workspaces/{workspaceId}/kubernetes-clusters/{clusterId}/resources",
                  "GET /api/v1/workspaces/{workspaceId}/kubernetes-clusters/metrics/history",
                  "GET /api/v1/workspaces/{workspaceId}/kubernetes-clusters/{clusterId}/metrics/history",
                  "GET /api/v1/workspaces/{workspaceId}/kubernetes-clusters/{clusterId}/pods/{namespace}/{podName}/logs",
                  "GET /api/v1/workspaces/{workspaceId}/virtual-machines",
                  "POST /api/v1/workspaces/{workspaceId}/virtual-machines",
                  "GET /api/v1/workspaces/{workspaceId}/virtual-machines/{vmId}",
                  "PATCH /api/v1/workspaces/{workspaceId}/virtual-machines/{vmId}",
                  "DELETE /api/v1/workspaces/{workspaceId}/virtual-machines/{vmId}",
                  "POST /api/v1/workspaces/{workspaceId}/virtual-machines/{vmId}/rotate-agent-key",
                  "GET /api/v1/workspaces/{workspaceId}/virtual-machines/{vmId}/resources",
                  "GET /api/v1/workspaces/{workspaceId}/virtual-machines/{vmId}/metrics/history",
                  "GET /api/v1/workspaces/{workspaceId}/virtual-machines/{vmId}/logs"
                ]
              },
              {
                "group": "Sessions and runs",
                "pages": [
                  "GET /api/v1/workspaces/{workspaceId}/targets/{targetId}/sessions",
                  "POST /api/v1/workspaces/{workspaceId}/targets/{targetId}/sessions",
                  "GET /api/v1/workspaces/{workspaceId}/targets/{targetId}/chat-activity",
                  "GET /api/v1/workspaces/{workspaceId}/kubernetes-clusters/{clusterId}/sessions",
                  "POST /api/v1/workspaces/{workspaceId}/kubernetes-clusters/{clusterId}/sessions",
                  "GET /api/v1/sessions/{sessionId}",
                  "DELETE /api/v1/sessions/{sessionId}",
                  "GET /api/v1/sessions/{sessionId}/messages",
                  "POST /api/v1/sessions/{sessionId}/messages",
                  "GET /api/v1/runs/{runId}",
                  "GET /api/v1/runs/{runId}/approvals",
                  "POST /api/v1/runs/{runId}/approvals/{approvalId}/decision",
                  "POST /api/v1/runs/{runId}/cancel",
                  "GET /api/v1/runs/{runId}/stream",
                  "GET /api/v1/runs/{runId}/events"
                ]
              },
              {
                "group": "Agent capabilities and target tools",
                "pages": [
                  "GET /api/v1/workspaces/{workspaceId}/targets/{targetId}/tools",
                  "PATCH /api/v1/workspaces/{workspaceId}/targets/{targetId}/tools/{toolId}",
                  "GET /api/v1/workspaces/{workspaceId}/agents/{agentId}/mcp/servers",
                  "POST /api/v1/workspaces/{workspaceId}/agents/{agentId}/mcp/servers",
                  "POST /api/v1/workspaces/{workspaceId}/agents/{agentId}/mcp/servers/import",
                  "PATCH /api/v1/workspaces/{workspaceId}/agents/{agentId}/mcp/servers/{serverId}",
                  "DELETE /api/v1/workspaces/{workspaceId}/agents/{agentId}/mcp/servers/{serverId}",
                  "POST /api/v1/workspaces/{workspaceId}/agents/{agentId}/mcp/servers/{serverId}/test-connection",
                  "GET /api/v1/workspaces/{workspaceId}/agents/{agentId}/mcp/servers/{serverId}/tools",
                  "PATCH /api/v1/workspaces/{workspaceId}/agents/{agentId}/mcp/servers/{serverId}/tools/{toolName}",
                  "GET /api/v1/workspaces/{workspaceId}/agents/{agentId}/skills",
                  "POST /api/v1/workspaces/{workspaceId}/agents/{agentId}/skills",
                  "POST /api/v1/workspaces/{workspaceId}/agents/{agentId}/skills/import"
                ]
              },
              {
                "group": "Webhooks",
                "pages": [
                  "GET /api/v1/workspaces/{workspaceId}/webhooks",
                  "POST /api/v1/workspaces/{workspaceId}/webhooks",
                  "GET /api/v1/workspaces/{workspaceId}/webhooks/{webhookId}",
                  "PATCH /api/v1/workspaces/{workspaceId}/webhooks/{webhookId}",
                  "DELETE /api/v1/workspaces/{workspaceId}/webhooks/{webhookId}",
                  "GET /api/v1/workspaces/{workspaceId}/webhooks/{webhookId}/history",
                  "POST /api/v1/external-integrations/webhook-routes/connect",
                  "GET /api/v1/external-integrations/webhook-routes/status"
                ]
              }
            ]
          },
          {
            "group": "Admin API reference",
            "openapi": {
              "source": "openapi/control-plane-admin.json",
              "directory": "reference/admin"
            },
            "pages": [
              {
                "group": "Identity and system",
                "pages": [
                  "GET /admin/v1/me",
                  "GET /admin/v1/system/readiness",
                  "GET /admin/v1/system/config"
                ]
              },
              {
                "group": "Workspace administration",
                "pages": [
                  "GET /admin/v1/workspaces",
                  "GET /admin/v1/workspaces/{workspaceId}",
                  "PATCH /admin/v1/workspaces/{workspaceId}/plan",
                  "PATCH /admin/v1/workspaces/{workspaceId}/quotas",
                  "POST /admin/v1/workspaces/{workspaceId}/members",
                  "PATCH /admin/v1/workspaces/{workspaceId}/members/{userId}/role",
                  "DELETE /admin/v1/workspaces/{workspaceId}/members/{userId}"
                ]
              },
              {
                "group": "User administration",
                "pages": [
                  "GET /admin/v1/users",
                  "GET /admin/v1/users/{userId}",
                  "POST /admin/v1/users/{userId}/sessions/revoke"
                ]
              },
              {
                "group": "Target operations",
                "pages": [
                  "GET /admin/v1/targets",
                  "GET /admin/v1/targets/{targetId}/agent",
                  "POST /admin/v1/targets/{targetId}/agent/disconnect",
                  "POST /admin/v1/targets/{targetId}/agent-key/rotate"
                ]
              },
              {
                "group": "Run operations",
                "pages": [
                  "GET /admin/v1/runs",
                  "GET /admin/v1/runs/{runId}",
                  "POST /admin/v1/runs/{runId}/cancel",
                  "POST /admin/v1/runs/{runId}/mark-failed"
                ]
              },
              {
                "group": "Audit and tooling",
                "pages": [
                  "POST /admin/v1/tooling/sync",
                  "GET /admin/v1/admin-audit-events",
                  "GET /admin/v1/audit-events"
                ]
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Demo",
          "href": "https://console.demo.acornops.dev/",
          "icon": "book-open-cover"
        },
        {
          "anchor": "API",
          "href": "/developer/api-overview",
          "icon": "terminal"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Contribute",
        "href": "https://github.com/acornops/acornops"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Try demo",
      "href": "https://console.demo.acornops.dev/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/acornops"
    }
  }
}
